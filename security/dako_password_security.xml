<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dako_password_module_category" model="ir.module.category">
        <field name="name">Contraseñas</field>
        <field name="description">Acceso al gestor de credenciales del equipo.</field>
        <field name="sequence">90</field>
    </record>

    <record id="dako_password_group_manager" model="res.groups">
        <field name="name">Administrador de contraseñas</field>
        <field name="category_id" ref="dako_password_module_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Ve y gestiona todos los vaults, borra credenciales y consulta la auditoría de accesos.</field>
    </record>

    <record id="dako_password_vault_rule_user" model="ir.rule">
        <field name="name">dako.password.vault: solo los vaults donde el usuario está anotado</field>
        <field name="model_id" ref="model_dako_password_vault"/>
        <field name="domain_force">[('user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="dako_password_vault_rule_manager" model="ir.rule">
        <field name="name">dako.password.vault: el Administrador ve todos</field>
        <field name="model_id" ref="model_dako_password_vault"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('dako_password_group_manager'))]"/>
    </record>

    <record id="dako_password_rule_user" model="ir.rule">
        <field name="name">dako.password: solo las credenciales de sus vaults</field>
        <field name="model_id" ref="model_dako_password"/>
        <field name="domain_force">[('vault_id.user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="dako_password_rule_manager" model="ir.rule">
        <field name="name">dako.password: el Administrador ve todas</field>
        <field name="model_id" ref="model_dako_password"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('dako_password_group_manager'))]"/>
    </record>

</odoo>
