<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dako_password.PasswordField">
        <div class="o_dako_password_field d-flex align-items-center gap-1 w-100"
             t-att-class="isEditing() ? 'flex-wrap' : 'flex-nowrap'"
             t-on-click.stop="" t-on-mousedown.stop="">
            <t t-if="isEditing()">
                <input t-ref="input"
                       class="o_input o_dako_password_input font-monospace"
                       t-att-id="props.id"
                       t-att-type="state.showTyped ? 'text' : 'password'"
                       t-att-placeholder="props.placeholder or 'Escribí o generá la contraseña'"
                       autocomplete="new-password"
                       spellcheck="false"
                       data-1p-ignore=""
                       data-lpignore="true"
                       t-on-input="onInput"/>
                <div class="o_dako_password_actions d-flex align-items-center">
                    <button type="button" class="btn btn-link btn-sm o_dako_password_button"
                            t-att-title="state.showTyped ? 'Ocultar' : 'Mostrar'"
                            t-att-aria-label="state.showTyped ? 'Ocultar' : 'Mostrar'"
                            t-on-click="onClickToggleTyped">
                        <i t-att-class="state.showTyped ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                    </button>
                    <button type="button" class="btn btn-link btn-sm o_dako_password_button o_dako_password_generate"
                            title="Generar una contraseña segura" aria-label="Generar una contraseña segura"
                            t-on-click="onClickGenerate">
                        <i class="fa fa-magic"/>
                    </button>
                    <button type="button" class="btn btn-link btn-sm o_dako_password_button"
                            title="Copiar" aria-label="Copiar"
                            t-on-click="onClickCopyTyped">
                        <i class="fa fa-clone"/>
                    </button>
                    <button t-if="props.record.resId" type="button"
                            class="btn btn-link btn-sm o_dako_password_button o_dako_password_cancel"
                            title="No cambiar la contraseña" aria-label="No cambiar la contraseña"
                            t-on-click="onClickCancel">
                        <i class="fa fa-times"/>
                    </button>
                </div>
            </t>
            <t t-elif="props.record.resId">
                <span class="o_dako_password_value font-monospace"
                      t-att-class="isRevealed() ? 'o_dako_password_revealed text-break' : 'o_dako_password_masked text-truncate'"
                      t-esc="displayValue()"/>
                <div class="o_dako_password_actions d-flex align-items-center">
                    <button type="button" class="btn btn-link btn-sm o_dako_password_button o_dako_password_reveal"
                            t-att-title="isRevealed() ? 'Ocultar' : 'Mostrar'"
                            t-att-aria-label="isRevealed() ? 'Ocultar' : 'Mostrar'"
                            t-on-click="onClickReveal">
                        <i t-att-class="isRevealed() ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                    </button>
                    <button type="button" class="btn btn-link btn-sm o_dako_password_button o_dako_password_copy"
                            title="Copiar" aria-label="Copiar"
                            t-on-click="onClickCopy">
                        <i class="fa fa-clone"/>
                    </button>
                    <button t-if="!props.readonly" type="button"
                            class="btn btn-link btn-sm o_dako_password_button o_dako_password_change"
                            title="Cambiar la contraseña" aria-label="Cambiar la contraseña"
                            t-on-click="onClickChange">
                        <i class="fa fa-pencil"/>
                        <span class="ms-1">Cambiar</span>
                    </button>
                </div>
            </t>
        </div>
    </t>

</templates>
