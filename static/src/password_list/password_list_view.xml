<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Odoo 19: web.ListView.Buttons is an empty extension point, called from the
         layout-buttons slot of the control panel; the template stands on its own. -->
    <t t-name="dako_password.ListView.Buttons">
        <t t-if="!editedRecord">
            <button type="button" class="btn btn-secondary o_dako_password_reveal_all"
                    t-att-title="allRevealed() ? 'Ocultar todas las contraseñas' : 'Mostrar las contraseñas de esta página'"
                    t-att-aria-label="allRevealed() ? 'Ocultar todas las contraseñas' : 'Mostrar las contraseñas de esta página'"
                    t-on-click="onClickRevealAll">
                <i t-att-class="allRevealed() ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                <span t-if="!env.isSmall" class="ms-1" t-esc="allRevealed() ? 'Ocultar todas' : 'Mostrar todas'"/>
            </button>
            <button t-if="dakoState.canExport" type="button"
                    class="btn btn-secondary o_dako_password_export"
                    title="Exportar a Excel lo seleccionado o, si no hay selección, todo lo que muestra la búsqueda"
                    aria-label="Exportar a Excel"
                    t-on-click="onClickExportXlsx">
                <i class="fa fa-file-excel-o"/>
                <span t-if="!env.isSmall" class="ms-1">Exportar Excel</span>
            </button>
        </t>
    </t>

</templates>
