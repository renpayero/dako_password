<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dako_password_access_log_view_list" model="ir.ui.view">
        <field name="name">dako.password.access.log.view.list</field>
        <field name="model">dako.password.access.log</field>
        <field name="arch" type="xml">
            <list string="Accesos a contraseñas" create="0" edit="0" delete="0">
                <field name="create_date" string="Fecha"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="action" widget="badge"
                       decoration-info="action == 'reveal'"
                       decoration-warning="action in ('copy', 'duplicate')"
                       decoration-danger="action == 'export'"/>
                <field name="credential_name"/>
                <field name="vault_name" string="Vault"/>
                <field name="credential_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dako_password_access_log_view_search" model="ir.ui.view">
        <field name="name">dako.password.access.log.view.search</field>
        <field name="model">dako.password.access.log</field>
        <field name="arch" type="xml">
            <search string="Buscar accesos">
                <field name="credential_name"/>
                <field name="vault_name" string="Vault"/>
                <field name="user_id"/>
                <filter string="Vio" name="filter_reveal" domain="[('action', '=', 'reveal')]"/>
                <filter string="Copió" name="filter_copy" domain="[('action', '=', 'copy')]"/>
                <filter string="Exportó" name="filter_export" domain="[('action', '=', 'export')]"/>
                <filter string="Duplicó" name="filter_duplicate" domain="[('action', '=', 'duplicate')]"/>
                <separator/>
                <filter string="Fecha" name="filter_date" date="create_date"/>
                <group>
                    <filter string="Usuario" name="groupby_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Credencial" name="groupby_credential" context="{'group_by': 'credential_id'}"/>
                    <filter string="Acción" name="groupby_action" context="{'group_by': 'action'}"/>
                    <filter string="Día" name="groupby_day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dako_password_access_log_action" model="ir.actions.act_window">
        <field name="name">Auditoría de accesos</field>
        <field name="res_model">dako.password.access.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="dako_password_access_log_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                Todavía nadie vio, copió ni exportó contraseñas
            </p>
            <p>
                Cada vez que alguien revela, copia, exporta o duplica una contraseña queda
                registrado acá.
            </p>
        </field>
    </record>

</odoo>
