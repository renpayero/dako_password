<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dako_password_view_form" model="ir.ui.view">
        <field name="name">dako.password.view.form</field>
        <field name="model">dako.password</field>
        <field name="arch" type="xml">
            <form string="Credencial">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_access_logs" type="object" class="oe_stat_button"
                                icon="fa-eye" groups="dako_password.dako_password_group_manager">
                            <field name="access_log_count" widget="statinfo" string="Accesos"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivada" bg_color="bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ej. Home banking Galicia"/>
                        </h1>
                        <field name="purpose" class="o_dako_password_purpose"
                               placeholder="¿Para qué se usa? Ej. pagos a proveedores"/>
                    </div>
                    <group>
                        <group string="Acceso" name="access">
                            <field name="url" widget="dako_password_copy"
                                   placeholder="https://... o 192.168.1.10:3389"/>
                            <field name="username" widget="dako_password_copy" placeholder="usuario@empresa.com"/>
                            <field name="password_input" widget="dako_password" required="not id"/>
                        </group>
                        <group string="Clasificación" name="classification">
                            <field name="vault_id" options="{'no_create': True}"/>
                            <field name="criticality" widget="selection_badge"/>
                            <field name="strength" widget="badge"
                                   decoration-danger="strength == 'weak'"
                                   decoration-warning="strength == 'medium'"
                                   decoration-success="strength == 'strong'"/>
                            <field name="strength_score" widget="progressbar"/>
                            <field name="password_changed_date" invisible="not id"/>
                        </group>
                    </group>
                    <group string="Notas" name="notes">
                        <field name="note" nolabel="1" colspan="2"
                               placeholder="Observaciones, preguntas de seguridad, contactos... No anotes contraseñas acá: las notas se ven sin registro de acceso."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="dako_password_view_list" model="ir.ui.view">
        <field name="name">dako.password.view.list</field>
        <field name="model">dako.password</field>
        <field name="arch" type="xml">
            <tree string="Credenciales" js_class="dako_password_list">
                <field name="name"/>
                <field name="purpose" optional="show"/>
                <field name="vault_id" optional="show"/>
                <field name="url" widget="dako_password_copy" optional="show"/>
                <field name="username" widget="dako_password_copy" optional="show"/>
                <field name="password_input" widget="dako_password"/>
                <field name="criticality" widget="badge"
                       decoration-danger="criticality == 'critical'"
                       decoration-warning="criticality == 'high'"
                       decoration-info="criticality == 'medium'"/>
                <field name="strength" widget="badge" optional="show"
                       decoration-danger="strength == 'weak'"
                       decoration-warning="strength == 'medium'"
                       decoration-success="strength == 'strong'"/>
                <field name="password_changed_date" optional="hide"/>
                <field name="note" optional="hide"/>
                <field name="create_uid" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="dako_password_view_kanban" model="ir.ui.view">
        <field name="name">dako.password.view.kanban</field>
        <field name="model">dako.password</field>
        <field name="arch" type="xml">
            <kanban class="o_dako_password_kanban">
                <field name="criticality_color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_color_#{record.criticality_color.raw_value}">
                            <div class="d-flex align-items-start justify-content-between gap-2">
                                <strong class="fs-5 text-truncate"><field name="name"/></strong>
                                <field name="criticality" widget="badge"
                                       decoration-danger="criticality == 'critical'"
                                       decoration-warning="criticality == 'high'"
                                       decoration-info="criticality == 'medium'"/>
                            </div>
                            <div class="text-muted"><field name="purpose"/></div>
                            <div class="text-muted small">
                                <i class="fa fa-lock me-1" title="Vault"/>
                                <field name="vault_id"/>
                            </div>
                            <div class="d-flex flex-column gap-1 mt-2">
                                <field name="url" widget="dako_password_copy"/>
                                <field name="username" widget="dako_password_copy"/>
                                <field name="password_input" widget="dako_password"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="dako_password_view_search" model="ir.ui.view">
        <field name="name">dako.password.view.search</field>
        <field name="model">dako.password</field>
        <field name="arch" type="xml">
            <search string="Buscar credenciales">
                <field name="name" string="Credencial"
                       filter_domain="['|', '|', '|', '|', ('name', 'ilike', self), ('purpose', 'ilike', self), ('url', 'ilike', self), ('username', 'ilike', self), ('note', 'ilike', self)]"/>
                <field name="vault_id"/>
                <field name="url"/>
                <field name="username"/>
                <filter string="Críticas y altas" name="filter_critical"
                        domain="[('criticality', 'in', ('critical', 'high'))]"/>
                <filter string="Contraseñas débiles" name="filter_weak" domain="[('strength', '=', 'weak')]"/>
                <filter string="Más de un año sin cambiar" name="filter_old"
                        domain="[('password_changed_date', '&lt;', (context_today() - relativedelta(years=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="De mis vaults" name="filter_my_vaults" domain="[('vault_id.user_ids', 'in', uid)]"/>
                <separator/>
                <filter string="Archivadas" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Vault" name="groupby_vault" context="{'group_by': 'vault_id'}"/>
                    <filter string="Criticidad" name="groupby_criticality" context="{'group_by': 'criticality'}"/>
                    <filter string="Fortaleza" name="groupby_strength" context="{'group_by': 'strength'}"/>
                </group>
                <searchpanel>
                    <field name="vault_id" icon="fa-lock" enable_counters="1"/>
                    <field name="criticality" icon="fa-exclamation-triangle" select="multi" enable_counters="1" expand="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="dako_password_action" model="ir.actions.act_window">
        <field name="name">Credenciales</field>
        <field name="res_model">dako.password</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="dako_password_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cargá tu primera credencial
            </p>
            <p>
                Guardá acá los accesos del equipo: cada credencial vive en un vault y solo la
                ven los usuarios anotados en él. Si todavía no tenés un vault, crealo desde
                <i>Contraseñas &gt; Vaults</i>.
            </p>
        </field>
    </record>

</odoo>
