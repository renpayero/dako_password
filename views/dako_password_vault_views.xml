<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dako_password_vault_view_form" model="ir.ui.view">
        <field name="name">dako.password.vault.view.form</field>
        <field name="model">dako.password.vault</field>
        <field name="arch" type="xml">
            <form string="Vault">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_passwords" type="object" class="oe_stat_button" icon="fa-key">
                            <field name="password_count" widget="statinfo" string="Credenciales"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ej. Bancos, Servidores, Proveedores"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_ids" widget="many2many_tags_avatar" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group string="Descripción" name="description">
                        <field name="description" nolabel="1" colspan="2"
                               placeholder="Qué guarda este vault y quién lo administra."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="dako_password_vault_view_kanban" model="ir.ui.view">
        <field name="name">dako.password.vault.view.kanban</field>
        <field name="model">dako.password.vault</field>
        <field name="arch" type="xml">
            <kanban action="action_open_passwords" type="object" class="o_dako_password_vault_kanban">
                <field name="color"/>
                <field name="password_count"/>
                <field name="critical_count"/>
                <templates>
                    <t t-name="kanban-menu">
                        <a role="menuitem" type="edit" class="dropdown-item">Editar vault</a>
                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                    </t>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{kanban_color(record.color.raw_value)} oe_kanban_global_click">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-lock text-muted" title="Vault"/>
                                <strong class="fs-5 text-truncate"><field name="name"/></strong>
                            </div>
                            <div class="text-muted text-truncate"><field name="description"/></div>
                            <div class="o_kanban_record_bottom pt-2 align-items-center">
                                <div class="oe_kanban_bottom_left d-flex flex-wrap gap-2">
                                    <span>
                                        <i class="fa fa-key me-1" title="Credenciales"/>
                                        <t t-esc="record.password_count.raw_value"/>
                                        <t t-if="record.password_count.raw_value === 1"> credencial</t>
                                        <t t-else=""> credenciales</t>
                                    </span>
                                    <span t-if="record.critical_count.raw_value" class="text-danger">
                                        <i class="fa fa-exclamation-triangle me-1" title="Críticas"/>
                                        <t t-esc="record.critical_count.raw_value"/>
                                        <t t-if="record.critical_count.raw_value === 1"> crítica</t>
                                        <t t-else=""> críticas</t>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="dako_password_vault_view_list" model="ir.ui.view">
        <field name="name">dako.password.vault.view.list</field>
        <field name="model">dako.password.vault</field>
        <field name="arch" type="xml">
            <tree string="Vaults">
                <field name="name"/>
                <field name="user_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="password_count"/>
                <field name="critical_count" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="dako_password_vault_view_search" model="ir.ui.view">
        <field name="name">dako.password.vault.view.search</field>
        <field name="model">dako.password.vault</field>
        <field name="arch" type="xml">
            <search string="Buscar vaults">
                <field name="name"/>
                <field name="user_ids"/>
                <filter string="Mis vaults" name="filter_mine" domain="[('user_ids', 'in', uid)]"/>
                <separator/>
                <filter string="Archivados" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="dako_password_vault_action" model="ir.actions.act_window">
        <field name="name">Vaults</field>
        <field name="res_model">dako.password.vault</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="dako_password_vault_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Creá un vault
            </p>
            <p>
                Un vault agrupa las credenciales de un equipo, un sistema o un proveedor.
                Solo los usuarios autorizados ven su contenido.
            </p>
        </field>
    </record>

</odoo>
